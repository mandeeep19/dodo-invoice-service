# Copy to .env for local (non-Docker) runs. docker-compose.yml sets these
# itself for the containerized setup and does not need this file.
DATABASE_URL=postgres://dodo:dodo@localhost:5432/dodo_invoice
PORT=8080
PSP_BASE_URL=http://localhost:9000
PSP_SYNC_WAIT_MS=3000
PSP_HARD_TIMEOUT_MS=35000
RUST_LOG=info
